# Copy to `supabase/.env` (gitignored) — read by `supabase start` for the
# env(...) references in supabase/config.toml. Only needed for Google
# sign-in; see README > "Google OAuth locally".
#
# The OAuth app needs its callback URL set to Supabase's fixed one:
#   http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
