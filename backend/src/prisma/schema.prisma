generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ------------------- Users -------------------
model User {
  id        String   @id
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Global role (moderation / permissions) — separate from per-tree roles (see `Role`).
  // Site admins and guests are not users: they have their own tables (`Admin`, `Guest`).
  role UserRole @default(USER)

  // Moderator action: blocks login without deleting the account (admin-only action)
  suspended Boolean @default(false)

  // 2FA (TOTP)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  recoveryCodes    RecoveryCode[]

  // Profile (assigned to user when sign up)
  profileId Int? @unique
  profile Profile? @relation(fields: [profileId], references: [id])

  //Add friend
  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")
}

enum UserRole {
  MODERATOR
  USER
}

// ------------------- Site admins -------------------
// The admin console accounts ("Sign in as staff"), kept apart from User: no
// profile, trees, friends or invitations. The id is the Supabase login's UUID,
// like User.id; one Supabase login is either an admin or a user, never both.
// Admins are added and removed from the console (AdminsController), not by
// changing a user's role. MFA is required (JwtStrategy).
model Admin {
  id        String   @id
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 2FA (TOTP)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  recoveryCodes    RecoveryCode[]
}

// ------------------- Guests -------------------
// "Try as guest" visitors: one row per visit, with its own profile and copy of
// the demo tree (AuthService.loginAsGuest). No Supabase login, email, friends
// or MFA. Removed with their tree after 15 idle minutes; JwtStrategy keeps
// lastSeenAt. The profile's userId holds the guest's id (it's a plain column),
// so the profile counts as the guest's own, like a user's.
model Guest {
  id         String   @id
  tag        String   @unique // short random name, e.g. guest-1a2b3c4d
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  profileId Int     @unique
  profile   Profile @relation(fields: [profileId], references: [id])

  @@index([lastSeenAt])
}

// Sessions ended with Logout (POST /auth/logout), by the token's jti. Our JWTs
// can't be taken back, so JwtStrategy refuses any token listed here. A row is
// only needed until the token would have expired anyway; AuthService removes
// it then.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

// ------------------- Site settings -------------------
// A single row (id 1). guestAccess turns "Try as guest" on and off (admin
// console, Users page).
model SiteSettings {
  id          Int     @id @default(1)
  guestAccess Boolean @default(true)
}

// ------------------- 2FA Recovery Codes -------------------
// Belongs to a user or an admin (exactly one of userId / adminId is set).
model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([adminId])
}

// ------------------- Family Trees -------------------
model Tree {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  code        String?  @unique// 6-8 character alphanumeric join code
  description String?
  ownerId     Int
  owner       Profile  @relation("TreeOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublic    Boolean  @default(false)  // If true, viewers can view without code
  rootId      Int      @unique
  root        TreeMember @relation("RootProfile", fields: [rootId], references: [id])

  // Members (users with roles)
  members TreeMember[]

  // Audit logs
  auditLogs AuditLog[]
}

// ------------------- Tree Members (Roles) -------------------
model TreeMember {
  id        Int      @id @default(autoincrement())
  profileId Int?
  treeId    Int?
  role      Role     // ADMIN, MODERATOR, MEMBER, JOINER, HOLDER
  joinedAt  DateTime @default(now())

  //Link Profile
  claim     Status      @default(EMPTY)
  linkId    Int?        @unique
  link      TreeMember? @relation("Linked Profile", fields: [linkId], references: [id])
  linkWith  TreeMember? @relation("Linked Profile")

  profile   Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tree      Tree?     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  rootProfile Tree?    @relation("RootProfile")

  @@unique([profileId, treeId])
}

enum Role {
  ADMIN      // Full control: edit tree, manage members, delete tree
  MEMBER     // Can view full tree, add/edit own profiles, add persons
  JOINER     // Read-only: view tree and profiles only
  HOLDER     // Placeholder profile
}

enum Status {
  EMPTY
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId String
  requester   User     @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      Status   @default(EMPTY)
  createdAt   DateTime @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
}


// ------------------- Profiles ---------------------------------
model Profile {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String?
  gender      String?
  birthDate   DateTime? @db.Date
  bio         String?
  photoUrl    String?
  verified    Boolean  @default(false)

  // Trees this user owns (created by them)
  ownedTrees Tree[]    @relation("TreeOwner")

  // Memberships in trees (with roles)
  treeMembers TreeMember[]

  // Parents (self-referential)
  motherId    Int?     @map("mother_id")
  fatherId    Int?     @map("father_id")
  mother      Profile? @relation("MotherChildren", fields: [motherId], references: [id])
  father      Profile? @relation("FatherChildren", fields: [fatherId], references: [id])

  childrenAsMother Profile[] @relation("MotherChildren")
  childrenAsFather Profile[] @relation("FatherChildren")

  // Spouses
  spouseId    Int? @map("spouse_id") @unique
  spouse      Profile? @relation("Spouse", fields: [spouseId], references: [id])
  spouseOf    Profile? @relation("Spouse")

  auditLogs AuditLog[]

  // User who owned this profile (optional)
  userId      String? @unique
  user        User? @relation
  guest       Guest?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

// ------------------- Audit Log -------------------
model AuditLog {
  id        Int      @id @default(autoincrement())
  treeId    Int
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([treeId, createdAt])
}
