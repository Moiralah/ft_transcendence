generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ------------------- Users -------------------
model User {
  id        String   @id
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Trees this user owns (created by them)
  ownedTrees Tree[]    @relation("TreeOwner")

  // Memberships in trees (with roles)
  treeMembers TreeMember[]

  // Profiles (persons claimed by this user)
  profiles Profile[]

  // Audit logs
  auditLogs AuditLog[]

  // Invitations sent
  sentInvitations Invitation[] @relation("Inviter")
}

// ------------------- Family Trees -------------------
model Tree {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String?  @unique// 6-8 character alphanumeric join code
  description String?
  ownerId     String
  owner       User     @relation("TreeOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublic    Boolean  @default(false)  // If true, viewers can view without code

  // Members (users with roles)
  members TreeMember[]

  // Profiles (people in this tree)
  profiles Profile[]

  // Audit logs
  auditLogs AuditLog[]

  // Invitations sent for this tree
  invitations Invitation[]
}

// ------------------- Tree Members (Roles) -------------------
model TreeMember {
  id        Int      @id @default(autoincrement())
  userId    String
  treeId    Int
  role      Role     // ADMIN, MODERATOR, MEMBER, VIEWER
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([userId, treeId])
}

enum Role {
  ADMIN      // Full control: edit tree, manage members, delete tree
  MODERATOR  // Can edit profiles, manage invitations
  MEMBER     // Can view full tree, add/edit own profiles, add persons
  VIEWER     // Read-only: view tree and profiles only
}

// ------------------- Invitations -------------------
model Invitation {
  id          Int      @id @default(autoincrement())
  inviterId   String
  inviteeEmail String
  treeId      Int
  role        Role     @default(MEMBER)
  status      InviteStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  respondedAt DateTime?

  inviter     User     @relation("Inviter", fields: [inviterId], references: [id])
  tree        Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([inviteeEmail, treeId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ------------------- Profiles (formerly Person) -------------------
model Profile {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String?
  gender      String?
  birthDate   DateTime?
  deathDate   DateTime?
  bio         String?
  photoUrl    String?
  verified    Boolean  @default(false)

  // Tree this profile belongs to
  treeId      Int
  tree        Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)

  // Parents (self-referential)
  motherId    Int?     @map("mother_id")
  fatherId    Int?     @map("father_id")
  mother      Profile? @relation("MotherChildren", fields: [motherId], references: [id])
  father      Profile? @relation("FatherChildren", fields: [fatherId], references: [id])

  childrenAsMother Profile[] @relation("MotherChildren")
  childrenAsFather Profile[] @relation("FatherChildren")

  // Spouses
  spousesFrom ProfileSpouse[] @relation("Spouse1")
  spousesTo   ProfileSpouse[] @relation("Spouse2")

  // Life events
  events Event[]

  // User who claimed this profile (optional)
  claimedById String?
  claimedBy   User?    @relation(fields: [claimedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

// ------------------- Spouse Relationship -------------------
model ProfileSpouse {
  id            Int      @id @default(autoincrement())
  profile1Id    Int
  profile2Id    Int
  marriageDate  DateTime?
  divorceDate   DateTime?

  profile1      Profile  @relation("Spouse1", fields: [profile1Id], references: [id], onDelete: Cascade)
  profile2      Profile  @relation("Spouse2", fields: [profile2Id], references: [id], onDelete: Cascade)

  @@unique([profile1Id, profile2Id])
  @@map("profile_spouses")
}

// ------------------- Life Events -------------------
model Event {
  id          Int      @id @default(autoincrement())
  profileId   Int
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  eventType   String
  description String?
  eventDate   DateTime?
  location    String?
  createdAt   DateTime @default(now())

  @@map("events")
}

// ------------------- Audit Log -------------------
model AuditLog {
  id        Int      @id @default(autoincrement())
  treeId    Int
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([treeId, createdAt])
}