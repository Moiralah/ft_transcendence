generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

// ------------------- Users -------------------
model User {
  id        String   @id
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile (assigned to user when sign up)
  profileId Int? @unique
  profile Profile? @relation(fields: [profileId], references: [id])

  // Audit logs
  auditLogs AuditLog[]

  // Invitations sent
  sentInvitations Invitation[] @relation("Inviter")
}

// ------------------- Family Trees -------------------
model Tree {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String?  @unique// 6-8 character alphanumeric join code
  description String?
  ownerId     Int
  owner       Profile  @relation("TreeOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isPublic    Boolean  @default(false)  // If true, viewers can view without code
  rootId      Int      @unique
  root        TreeMember @relation("RootProfile", fields: [rootId], references: [id])

  // Members (users with roles)
  members TreeMember[]

  // Audit logs
  auditLogs AuditLog[]

  // Invitations sent for this tree
  invitations Invitation[]
}

// ------------------- Tree Members (Roles) -------------------
model TreeMember {
  id        Int      @id @default(autoincrement())
  profileId Int?
  treeId    Int?
  role      Role     // ADMIN, MODERATOR, MEMBER, JOINER, HOLDER
  joinedAt  DateTime @default(now())

  //Link Profile
  claim     Status      @default(EMPTY)
  linkId    Int?        @unique
  link      TreeMember? @relation("Linked Profile", fields: [linkId], references: [id])
  linkWith  TreeMember? @relation("Linked Profile")

  profile   Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tree      Tree?     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  rootProfile Tree?    @relation("RootProfile")

  @@unique([profileId, treeId])
}

enum Role {
  ADMIN      // Full control: edit tree, manage members, delete tree
  MODERATOR  // Can edit profiles, manage invitations
  MEMBER     // Can view full tree, add/edit own profiles, add persons
  JOINER     // Read-only: view tree and profiles only
  HOLDER     // Placeholder profile
}

enum Status {
  EMPTY
  PENDING
  ACCEPTED
  REJECTED
}

// ------------------- Invitations -------------------
model Invitation {
  id          Int      @id @default(autoincrement())
  inviterId   String
  inviteeEmail String
  treeId      Int
  role        Role     @default(JOINER)
  invite      Status   @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  respondedAt DateTime?

  inviter     User     @relation("Inviter", fields: [inviterId], references: [id])
  tree        Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@unique([inviteeEmail, treeId])
}

// ------------------- Profiles (formerly Person) -------------------
model Profile {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String?
  gender      String?
  birthDate   DateTime? @db.Date
  deathDate   DateTime? @db.Date
  bio         String?
  photoUrl    String?
  verified    Boolean  @default(false)


  // Trees this user owns (created by them)
  ownedTrees Tree[]    @relation("TreeOwner")

  // Memberships in trees (with roles)
  treeMembers TreeMember[]

  // Parents (self-referential)
  motherId    Int?     @map("mother_id")
  fatherId    Int?     @map("father_id")
  mother      Profile? @relation("MotherChildren", fields: [motherId], references: [id])
  father      Profile? @relation("FatherChildren", fields: [fatherId], references: [id])

  childrenAsMother Profile[] @relation("MotherChildren")
  childrenAsFather Profile[] @relation("FatherChildren")

  // Spouses
  spouseId    Int? @map("spouse_id") @unique
  spouse      Profile? @relation("Spouse", fields: [spouseId], references: [id])
  spouseOf    Profile? @relation("Spouse")

  // Life events
  events Event[]

  auditLogs AuditLog[]


  // User who owned this profile (optional)
  userId      String? @unique
  user        User? @relation

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("profiles")
}

// ------------------- Life Events -------------------
model Event {
  id          Int      @id @default(autoincrement())
  profileId   Int
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  eventType   String
  description String?
  eventDate   DateTime?
  location    String?
  createdAt   DateTime @default(now())

  @@map("events")
}

// ------------------- Audit Log -------------------
model AuditLog {
  id        Int      @id @default(autoincrement())
  treeId    Int
  tree      Tree     @relation(fields: [treeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([treeId, createdAt])
}
