# Copy this file to `.env` and fill it in:   cp .env.example .env
# `.env` is gitignored — never commit real values. Everything below is for the
# LOCAL Supabase stack (`supabase start`); `supabase status -o env` prints the
# keys you need. See README > "Running Supabase Locally".

# ---------------- Backend (NestJS) ----------------
PORT=4000
NODE_ENV=development
API_PREFIX=api
# Origin the browser loads the app from (CORS). `make security` overrides this
# to https://localhost:8443 for its own stack, so this is the plain `make up` value.
CORS_ORIGIN=https://localhost:3000

# Signs the app's own session tokens. Use a long random string:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600

# Supabase Auth (used to verify Google/GitHub/email sign-ins).
# If the backend runs in Docker (`make up`), use host.docker.internal instead of
# 127.0.0.1 in the three URLs below — see README section 4. (`make security`
# sets the Docker-side values for you.)
SUPABASE_AUTH_URL=http://127.0.0.1:54321
# The *service role / secret* key from `supabase status -o env` (SERVICE_ROLE_KEY).
# NOT the publishable/anon key — that one cannot delete users.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here

# Postgres (local Supabase defaults). DIRECT_URL is used by Prisma migrations.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------- Frontend (Next.js) ----------------
# Baked into the browser bundle, so these are public by design — never put a
# secret in a NEXT_PUBLIC_* variable. `make security` overrides the API URL to
# https://localhost:9443/api so requests go through the WAF.
NEXT_PUBLIC_API_URL=https://localhost:4000/api
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable / anon key from `supabase status -o env` (ANON_KEY or PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-anon-or-publishable-key-here

# ---------------- Not set here ----------------
# VAULT_ADDR / VAULT_ROLE_ID / VAULT_SECRET_ID are generated by
# scripts/vault-init.sh on every `make security` — do not add them.
# Google/GitHub OAuth credentials for local Supabase go in supabase/.env
# (see supabase/.env.example).
